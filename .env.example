# Port the Express app listens on
PORT=4000

# MongoDB connection string.
#
# - Inside Docker Compose: docker-compose.yml sets this to
#   mongodb://mongo:27017/yelp-camp automatically ("mongo" is the
#   service name of the database container) - you don't need to set
#   anything yourself for that case.
#
# - Running natively without Docker (node app.js): copy this file to
#   .env and point this at your local MongoDB instance, e.g.:
MONGO_URI=mongodb://127.0.0.1:27017/yelp-camp
